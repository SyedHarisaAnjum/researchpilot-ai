# Copy to .env (next to docker-compose.yml) and fill in. Never commit the filled-in file.

# --- Required secrets ---
GEMINI_API_KEY=
TAVILY_API_KEY=
# A long random password, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Model ---
GEMINI_MODEL=gemini-2.5-flash

# --- Host port for the web server (put HTTPS in front of it; see Readme.md) ---
HTTP_PORT=8080

# Session cookies are Secure (HTTPS only). Browsers also accept them on http://localhost,
# so the stack can be tried locally before HTTPS is set up.

# --- Optional limits (defaults shown) ---
# MAX_CONCURRENT_JOBS=2            # research jobs the worker runs at once
# MAX_ACTIVE_JOBS=10               # queued + running, all users
# MAX_ACTIVE_JOBS_PER_USER=3
# RESEARCH_JOBS_PER_MINUTE=5       # per user
# RESEARCH_JOBS_PER_HOUR=30        # per user
# LOGIN_ATTEMPTS_PER_15_MINUTES=10
# SESSION_DAYS=14
# MAX_LLM_CALLS=30                 # standard depth budget
# MAX_TOTAL_TOKENS=500000
# ENABLE_DOCS=false                # interactive API docs at /api/docs
